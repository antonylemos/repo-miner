{
  "name": "repo-discovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "format": "biome format --write src tests config *.json *.ts",
    "lint": "biome lint src tests config *.json *.ts",
    "check": "biome check src tests config *.json *.ts",
    "cli": "node dist/src/cli/main.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "commander": "^15.0.0"
  }
}
